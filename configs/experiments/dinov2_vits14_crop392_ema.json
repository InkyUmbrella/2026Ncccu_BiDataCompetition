{
  "experiment": "dinov2_vits14_crop392_ema",
  "seed": 42,
  "device": "cuda",
  "output_root": "outputs/audited",
  "data": {
    "root": "dataset/glaucoma_first",
    "image_size": 392,
    "num_workers": 8,
    "verify_images": true,
    "crop_black_border": true,
    "crop_threshold": 10,
    "crop_margin": 0.03,
    "normalization": "imagenet"
  },
  "model": {
    "name": "dinov2_vits14",
    "params": {"use_age": false, "hidden_dim": 128, "dropout": 0.2},
    "weights": "LVD142M"
  },
  "train": {
    "epochs": 15,
    "batch_size": 16,
    "accumulation_steps": 8,
    "learning_rate": 0.0001,
    "min_learning_rate": 0.000001,
    "warmup_epochs": 1,
    "weight_decay": 0.05,
    "pos_weight": 5.0,
    "grad_clip": 1.0,
    "amp": true,
    "backbone_lr_scale": 0.1,
    "ema_decay": 0.999
  }
}
