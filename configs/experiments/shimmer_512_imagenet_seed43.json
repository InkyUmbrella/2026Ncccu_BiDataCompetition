{
  "experiment": "shimmer_512_imagenet_seed43",
  "seed": 43,
  "device": "cuda",
  "output_root": "outputs/shimmer",
  "data": {
    "root": "dataset/glaucoma_first",
    "image_size": 512,
    "num_workers": 8,
    "verify_images": true,
    "crop_black_border": true,
    "crop_threshold": 10,
    "crop_margin": 0.03,
    "decode": "draft",
    "normalization": "imagenet"
  },
  "model": {
    "name": "convnext_tiny",
    "params": {
      "use_age": false,
      "hidden_dim": 128,
      "dropout": 0.2,
      "stochastic_depth_prob": 0.1
    },
    "weights": "IMAGENET1K_V1"
  },
  "train": {
    "epochs": 30,
    "batch_size": 16,
    "accumulation_steps": 8,
    "learning_rate": 0.0001,
    "min_learning_rate": 1e-06,
    "warmup_epochs": 1,
    "weight_decay": 0.05,
    "pos_weight": 1.0,
    "grad_clip": 1.0,
    "amp": true,
    "positive_fraction": 0.1428,
    "ema_decay": 0.999,
    "mixup_alpha": 0.2,
    "label_smoothing": 0.05,
    "backbone_lr_scale": 0.2,
    "evaluate_raw_with_ema": true
  }
}
