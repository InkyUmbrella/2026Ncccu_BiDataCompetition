{
  "experiment": "shimmer_384_pretrained_reference",
  "seed": 42,
  "device": "cuda",
  "output_root": "outputs/shimmer",
  "data": {
    "root": "dataset/glaucoma_first",
    "image_size": 384,
    "num_workers": 8,
    "verify_images": true,
    "crop_black_border": true,
    "crop_threshold": 10,
    "crop_margin": 0.03,
    "decode": "full",
    "normalization": "imagenet"
  },
  "model": {
    "name": "convnext_tiny",
    "params": {
      "use_age": false,
      "hidden_dim": 128,
      "dropout": 0.2,
      "stochastic_depth_prob": 0.1
    },
    "weights": "IMAGENET1K_V1"
  },
  "train": {
    "epochs": 30,
    "batch_size": 32,
    "accumulation_steps": 4,
    "learning_rate": 0.0001,
    "min_learning_rate": 1e-06,
    "warmup_epochs": 1,
    "weight_decay": 0.05,
    "pos_weight": 5.0,
    "grad_clip": 1.0,
    "amp": true,
    "positive_fraction": null,
    "ema_decay": null,
    "mixup_alpha": null,
    "label_smoothing": 0.0,
    "backbone_lr_scale": 1.0
  }
}
